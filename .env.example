# Copy this file to `.env` and fill in your key(s). `.env` is gitignored.
#   cp .env.example .env && edit .env
# Scripts auto-load `.env` at startup (see src/utils/env.py).

# Reward judge (default provider: gemini). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Only needed if you switch configs/reward.yaml judge.provider to "openai"
# OPENAI_API_KEY=

# Optional: Weights & Biases logging (configs/train_rl.yaml logging.backend: wandb)
# WANDB_API_KEY=
